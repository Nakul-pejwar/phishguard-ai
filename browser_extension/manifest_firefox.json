{
  "manifest_version": 3,
  "name": "PhishGuard AI — Real-Time Phishing & Spoof Protection",
  "version": "2.0.0",
  "description": "AI-powered real-time phishing defense, BFSI lookalike detection, credential theft prevention, and zero-PII link scanner.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "webNavigation",
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://mail.google.com/*",
    "*://outlook.live.com/*",
    "*://outlook.office.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://mail.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*"
      ],
      "js": ["email_scanner.js"],
      "css": ["email_scanner.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "warning.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "phishguard-addon@phishguard.ai",
      "strict_min_version": "109.0"
    }
  }
}
