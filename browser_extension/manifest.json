{
  "manifest_version": 3,
  "name": "PhishGuard AI — Phishing & Fraud Shield",
  "version": "2.0.0",
  "description": "Real-time AI-powered protection against phishing URLs, brand lookalikes, and credential theft.",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://phishguard.vitalsnvectors.in/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://api.phishguard.ai/*",
    "https://*.phishguard.ai/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://mail.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*"
      ],
      "js": ["email_scanner.js"],
      "css": ["email_scanner.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "interstitial.html",
        "interstitial.js",
        "interstitial.css",
        "style.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PhishGuard AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}